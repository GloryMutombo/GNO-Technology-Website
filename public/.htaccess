Options -Indexes

RewriteEngine On

# Force the canonical HTTPS, non-www host in production.
RewriteCond %{HTTP_HOST} ^www\.gnod-tech\.co\.za$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://gnod-tech.co.za%{REQUEST_URI} [R=301,L,NE]

# The PHP form endpoint must never be routed through Angular.
RewriteRule ^api/ - [L]

# Serve real files as-is.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Serve clean route URLs from their prerendered files without adding a slash.
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# Leave other real directories alone after clean routes have been resolved.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Unknown paths fall through to Apache's 404 response and use the prerendered page.
ErrorDocument 404 /404/index.html

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|mjs|woff2?|webp|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
